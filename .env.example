# --- App ---
APP_ENV=local
APP_SECRET_KEY=change-me-to-a-random-64-char-value
LOG_LEVEL=INFO

# --- CORS ---
# Origin of the React frontend that will consume this API. No trailing slash.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# --- Postgres ---
DATABASE_URL=postgresql+asyncpg://af_binf:af_binf@localhost:5432/af_binf

# --- Redis ---
# Session store.
REDIS_URL=redis://localhost:6379/0

# --- Session cookie ---
SESSION_COOKIE_NAME=af_session
SESSION_TTL_SECONDS=86400
# Must be true in any non-localhost deployment (cookie requires HTTPS).
SESSION_COOKIE_SECURE=true
# "lax" is required for the OIDC redirect (top-level GET from the IdP) to carry
# the cookie back on /auth/callback. "strict" would drop the cookie on that
# redirect and break login. See docs/auth.md for the full tradeoff.
SESSION_COOKIE_SAMESITE=lax

# --- CSRF ---
CSRF_COOKIE_NAME=af_csrf
CSRF_HEADER_NAME=X-CSRF-Token

# --- OIDC / company SSO ---
# Fill these in with your IdP's values (Okta, Azure AD, Keycloak, etc).
# OIDC_ISSUER should be the issuer base URL; discovery document is expected at
# {OIDC_ISSUER}/.well-known/openid-configuration
OIDC_ISSUER=https://sso.example.com/realms/example
OIDC_CLIENT_ID=af-binf-backend
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=http://localhost:8000/api/auth/callback
OIDC_SCOPES=openid profile email
# Where to send the browser after a successful /auth/callback.
OIDC_POST_LOGIN_REDIRECT=http://localhost:5173/

# --- HPC / SSH dispatch ---
HPC_SSH_HOST=hpc-login.example.internal
HPC_SSH_PORT=22
HPC_SSH_USERNAME=svc-af-binf
# Prefer a key file over a password in real deployments.
HPC_SSH_PRIVATE_KEY_PATH=/run/secrets/hpc_ssh_key
HPC_SSH_PASSWORD=
# Absolute path, on the HPC side, of the script run as `<script> <job_id>` to
# dispatch a job. That script pulls the job's input JSON itself (GET
# /api/jobs/{id}/input.json, see HPC_PULL_API_KEY below) and owns everything
# from there: parsing it and submitting to SLURM.
HPC_DISPATCH_SCRIPT_AF2=/opt/af-binf/dispatch_af2.sh
HPC_DISPATCH_SCRIPT_AF3=/opt/af-binf/dispatch_af3.sh
# "ssh" (default) dispatches for real. "fake" never contacts the cluster: it
# waits HPC_FAKE_DISPATCH_DELAY_SECONDS and reports success, for local testing
# without HPC access. Jobs show as submitted but never run. Not allowed with
# APP_ENV=production.
HPC_DISPATCH_MODE=ssh
HPC_FAKE_DISPATCH_DELAY_SECONDS=3

# --- HPC dispatch queue ---
# POST /jobs only queues a job; the dispatcher process (python -m app.dispatcher)
# sends queued jobs to the HPC one at a time, for all users, over one reused
# SSH connection.
# Minimum seconds between two dispatch calls - caps dispatches at 3600/N per
# hour. Agree on this one with the HPC admins.
HPC_DISPATCH_MIN_INTERVAL_SECONDS=10
# Which queued job goes next: "fair" (round-robin between users) or "fifo"
# (first come, first served). Restart the API and the dispatcher after changing.
HPC_DISPATCH_ORDER=fair
# How often to check for new jobs while the queue is empty.
HPC_DISPATCH_POLL_INTERVAL_SECONDS=2
# While the HPC is unreachable, jobs stay queued and the dispatcher retries
# after this long, doubling each time up to the max.
HPC_DISPATCH_BACKOFF_INITIAL_SECONDS=15
HPC_DISPATCH_BACKOFF_MAX_SECONDS=300
# Close the SSH connection after this long without a dispatch.
HPC_SSH_IDLE_CLOSE_SECONDS=300
# Max jobs waiting for dispatch across all users; beyond that POST /jobs
# returns 503 with Retry-After. 0 disables the cap.
HPC_QUEUE_MAX_DEPTH=200

# --- Per-user submission quota ---
# At most JOB_QUOTA_MAX_SUBMISSIONS jobs (queued or submitted) per user in any
# rolling JOB_QUOTA_WINDOW_HOURS window; further POST /jobs calls get 429 with
# a Retry-After header. Failed dispatches don't count. 0 disables the limit.
JOB_QUOTA_MAX_SUBMISSIONS=5
JOB_QUOTA_WINDOW_HOURS=24

# --- HPC pull auth ---
# Base URL the HPC side uses to reach this API.
BACKEND_PUBLIC_BASE_URL=https://af-binf-backend.example.internal
# Shared secret the HPC side sends as `Authorization: Bearer <key>` to pull a
# job's input JSON (GET /api/jobs/{id}/input.json). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Copy the same value to wherever the HPC-side script/user keeps its credentials.
HPC_PULL_API_KEY=change-me
